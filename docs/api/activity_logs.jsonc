{
  // =========================================================================
  // KONTRAK API - MODUL ACTIVITY LOGS
  // Endpoint prefix: /api/v1/activity-logs
  // Hak Akses: Bearer Access Token (Hanya Super Admin / super_admin)
  // =========================================================================

  // ======================================================
  // LIST & FILTER ACTIVITY LOGS (Super Admin Only)
  // ======================================================
  "list": {
    "method": "GET",
    "endpoint": "/api/v1/activity-logs",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin"]
    },
    "parameters": {
      "query": {
        "page": "1",
        "per_page": "15",
        "actor_id": "1",
        "action": "user.create",
        "status": "success",
        "entity_type": "user",
        "risk_level": "high",
        "start_date": "2026-01-01",
        "end_date": "2026-12-31",
        "sort_by": "created_at",
        "order": "desc"
      }
    },
    "notes": [
      "Menampilkan daftar riwayat aktivitas sistem dengan filter komprehensif.",
      "Hanya dapat diakses oleh Super Admin (super_admin).",
      "Filter risk_level hanya menerima: low, medium, high (case-insensitive). Nilai 'CRITICAL' TIDAK valid di DB.",
      "Nilai 'all' atau kosong = tanpa filter. start_date/end_date format YYYY-MM-DD.",
      "sort_by whitelist: created_at, id, actor_name, action, entity_type, risk_level.",
      "order: asc | desc (default desc)."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil daftar log aktivitas",
        "body": {
          "success": true,
          "code": "ACTIVITY_LOG_LIST",
          "message": "Daftar log aktivitas berhasil diambil",
          "data": {
            "summary": {
              "total_logs": 128,
              "high_risk": 4,
              "failed_login": 2,
              "cms_action": 86
            },
            "pagination": {
              "page": 1,
              "limit": 15,
              "total": 128,
              "totalPages": 9
            },
            "items": [
              {
                "id": "1",
                "time": "2026-07-30T13:35:00Z",
                "actor": "Administrator Utama",
                "role": "super_admin",
                "action": "user.create",
                "entity": "user",
                "entityLabel": "Admin Berita",
                "description": "Membuat admin baru",
                "ip": "127.0.0.1",
                "device": "Mozilla/5.0 ...",
                "risk": "high",
                "metadata": {}
              }
            ]
          }
        }
      },
      "401": {
        "description": "Token tidak valid atau kadaluarsa",
        "body": {
          "success": false,
          "code": "UNAUTHORIZED",
          "message": "Akses ditolak. Token tidak valid."
        }
      },
      "403": {
        "description": "Bukan Super Admin",
        "body": {
          "success": false,
          "code": "FORBIDDEN",
          "message": "Akses ditolak. Hanya Super Admin yang diizinkan."
        }
      }
    }
  },

  // ======================================================
  // SUMMARY ACTIVITY LOGS (Super Admin Only) — untuk dashboard
  // ======================================================
  "summary": {
    "method": "GET",
    "endpoint": "/api/v1/activity-logs/summary",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin"]
    },
    "parameters": {
      "query": {
        "start_date": "2026-01-01",
        "end_date": "2026-12-31"
      }
    },
    "notes": [
      "Ringkasan statistik untuk dashboard admin (total log, high risk, failed login, aktivitas CMS).",
      "Dukungan filter tanggal opsional (start_date/end_date)."
    ],
    "responses": {
      "200": {
        "description": "Ringkasan berhasil diambil",
        "body": {
          "success": true,
          "code": "ACTIVITY_LOG_SUMMARY",
          "message": "Ringkasan log aktivitas berhasil diambil",
          "data": {
            "total_logs": 128,
            "high_risk": 4,
            "failed_login": 2,
            "cms_action": 86
          }
        }
      }
    }
  },

  // ======================================================
  // DETAIL ACTIVITY LOG (Super Admin Only)
  // ======================================================
  "detail": {
    "method": "GET",
    "endpoint": "/api/v1/activity-logs/:id",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "notes": [
      "Mengambil detail lengkap satu log aktivitas berdasarkan ID."
    ],
    "responses": {
      "200": {
        "description": "Detail log ditemukan",
        "body": {
          "success": true,
          "code": "ACTIVITY_LOG_DETAIL",
          "message": "Detail log aktivitas berhasil diambil",
          "data": {
            "id": 1,
            "actor_id": 1,
            "actor_name": "Administrator Utama",
            "actor_role": "super_admin",
            "action": "user.create",
            "status": "success",
            "entity_type": "user",
            "entity_id": 2,
            "entity_label": "Admin Berita",
            "risk_level": "high",
            "description": "Membuat admin baru",
            "ip_address": "127.0.0.1",
            "user_agent": "Mozilla/5.0 ...",
            "created_at": "2026-07-30T13:35:00Z"
          }
        }
      },
      "404": {
        "description": "Log tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Log aktivitas tidak ditemukan"
        }
      }
    }
  },

  // ======================================================
  // ENTITY LOGS (Super Admin Only)
  // ======================================================
  "entity_logs": {
    "method": "GET",
    "endpoint": "/api/v1/activity-logs/entity/:entityType/:entityID",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin"]
    },
    "parameters": {
      "path": {
        "entityType": "user",
        "entityID": "2"
      }
    },
    "notes": [
      "Mengambil riwayat log khusus untuk entitas tertentu (misal riwayat perubahan berita ID 5 atau user ID 2)."
    ],
    "responses": {
      "200": {
        "description": "Riwayat entitas berhasil diambil",
        "body": {
          "success": true,
          "code": "ENTITY_LOGS_RETRIEVED",
          "message": "Riwayat aktivitas entitas berhasil diambil",
          "data": [
            {
              "id": 1,
              "actor_name": "Administrator Utama",
              "action": "user.create",
              "created_at": "2026-07-30T13:35:00Z"
            }
          ]
        }
      }
    }
  }
}
