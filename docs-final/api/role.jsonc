{
  // =========================================================================
  // KONTRAK API - MODUL ROLE (CRUD tabel `roles`)
  // Hak Akses: Bearer Access Token + Role super_admin ATAU admin
  // (semua endpoint admin role memakai RoleMiddleware("super_admin", "admin"))
  // Reverse-dokumentasi dari implementasi backend yang ada (bukan desain baru).
  // =========================================================================

  // ======================================================
  // LIST ROLE (Admin)
  // ======================================================
  "list": {
    "method": "GET",
    "endpoint": "/api/v1/roles",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "parameters": {
      "query": {
        "page": "1",
        "limit": "10",
        "search": "admin",
        "status": "active",
        "sort": "newest"
      }
    },
    "notes": [
      "status: active | inactive | trash (nilai lain/ kosong = semua, tanpa filter soft-delete).",
      "sort: newest (default) | oldest | name_asc | name_desc (urutkan by display_name).",
      "page default 1; limit default 10, maksimal 100 (di-normalisasi di service).",
      "Search mencocokkan name ATAU display_name (LIKE).",
      "CATATAN: field user_count pada item response selalu 0 — mapper hardcode 0 dan service tidak mengisinya (lihat laporan temuan)."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil daftar role",
        "body": {
          "success": true,
          "code": "ROLE_LIST",
          "message": "berhasil mengambil data role",
          "data": [
            {
              "id": 1,
              "name": "super_admin",
              "display_name": "Super Administrator",
              "is_system": true,
              "is_active": true,
              "user_count": 0,
              "created_at": "2026-07-01T00:00:00Z",
              "updated_at": "2026-07-01T00:00:00Z"
            }
          ],
          "meta": {
            "current_page": 1,
            "limit": 10,
            "total_data": 4,
            "total_pages": 1
          }
        }
      },
      "401": {
        "description": "Token tidak valid atau kadaluarsa",
        "body": {
          "success": false,
          "code": "AUTH_TOKEN_INVALID_OR_EXPIRED",
          "message": "Sesi login telah berakhir. Silakan login kembali."
        }
      },
      "403": {
        "description": "Bukan super_admin/admin",
        "body": {
          "success": false,
          "code": "FORBIDDEN",
          "message": "Akses ditolak. Anda tidak memiliki izin."
        }
      }
    }
  },

  // ======================================================
  // DETAIL ROLE (Admin)
  // ======================================================
  "detail": {
    "method": "GET",
    "endpoint": "/api/v1/roles/:id",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "notes": [
      "Mengambil detail satu role. user_count selalu 0 (lihat catatan di list)."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil detail role",
        "body": {
          "success": true,
          "code": "ROLE_DETAIL",
          "message": "berhasil mengambil data role",
          "data": {
            "id": 1,
            "name": "super_admin",
            "display_name": "Super Administrator",
            "is_system": true,
            "is_active": true,
            "user_count": 0,
            "created_at": "2026-07-01T00:00:00Z",
            "updated_at": "2026-07-01T00:00:00Z"
          }
        }
      },
      "404": {
        "description": "Role tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Role tidak ditemukan"
        }
      }
    }
  },

  // ======================================================
  // CREATE ROLE (Admin)
  // ======================================================
  "create": {
    "method": "POST",
    "endpoint": "/api/v1/roles",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "request": {
      "name": "admin_berita",
      "display_name": "Admin Berita",
      "is_active": true
    },
    "validation": {
      "name": "required,max=50",
      "display_name": "required,max=100",
      "is_active": "boolean (opsional, default false)"
    },
    "notes": [
      "name dan display_name harus unik (cek duplikat termasuk di trash: kalau name sudah dipakai role yang terhapus, error validasi dengan pesan khusus).",
      "is_system tidak bisa di-set dari request; hanya ditentukan seed."
    ],
    "responses": {
      "201": {
        "description": "Role berhasil dibuat",
        "body": {
          "success": true,
          "code": "ROLE_CREATED",
          "message": "role berhasil dibuat",
          "data": {
            "id": 5,
            "name": "admin_berita",
            "display_name": "Admin Berita",
            "is_system": false,
            "is_active": true,
            "user_count": 0,
            "created_at": "2026-08-03T10:00:00Z",
            "updated_at": "2026-08-03T10:00:00Z"
          }
        }
      },
      "422": {
        "description": "Validasi gagal (binding atau duplikat)",
        "body": {
          "success": false,
          "code": "VALIDATION_ERROR",
          "message": "validasi gagal",
          "errors": {
            "name": "Kode role ini sudah digunakan"
          }
        }
      }
    }
  },

  // ======================================================
  // UPDATE ROLE (Admin)
  // ======================================================
  "update": {
    "method": "PUT",
    "endpoint": "/api/v1/roles/:id",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "parameters": {
      "path": {
        "id": "5"
      }
    },
    "request": {
      "name": "editor",
      "display_name": "Editor",
      "is_active": true
    },
    "validation": {
      "name": "required,max=50",
      "display_name": "required,max=100",
      "is_active": "boolean (opsional)"
    },
    "notes": [
      "Role bawaan sistem (is_system=true) TIDAK bisa diubah — error validasi 'Role bawaan sistem tidak dapat diubah'.",
      "name/display_name tidak boleh dipakai role lain (cek duplikat dengan exclude id sendiri)."
    ],
    "responses": {
      "200": {
        "description": "Role berhasil diperbarui",
        "body": {
          "success": true,
          "code": "ROLE_UPDATED",
          "message": "role berhasil diperbarui",
          "data": {
            "id": 5,
            "name": "editor",
            "display_name": "Editor",
            "is_system": false,
            "is_active": true,
            "user_count": 0,
            "created_at": "2026-08-03T10:00:00Z",
            "updated_at": "2026-08-03T11:00:00Z"
          }
        }
      },
      "404": {
        "description": "Role tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Role tidak ditemukan"
        }
      },
      "422": {
        "description": "Validasi gagal / role sistem",
        "body": {
          "success": false,
          "code": "VALIDATION_ERROR",
          "message": "validasi gagal",
          "errors": {
            "general": "Role bawaan sistem tidak dapat diubah"
          }
        }
      }
    }
  },

  // ======================================================
  // UPDATE STATUS ROLE (Admin)
  // ======================================================
  "update_status": {
    "method": "PATCH",
    "endpoint": "/api/v1/roles/:id/status",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "parameters": {
      "path": {
        "id": "5"
      }
    },
    "request": {
      "is_active": false
    },
    "validation": {
      "is_active": "required,boolean"
    },
    "notes": [
      "Role sistem tidak bisa dinonaktifkan.",
      "Role yang masih dipakai user aktif tidak bisa dinonaktifkan (error validasi)."
    ],
    "responses": {
      "200": {
        "description": "Status role berhasil diubah",
        "body": {
          "success": true,
          "code": "ROLE_STATUS_UPDATED",
          "message": "status role berhasil diubah"
        }
      },
      "422": {
        "description": "Role sistem / masih dipakai user",
        "body": {
          "success": false,
          "code": "VALIDATION_ERROR",
          "message": "validasi gagal",
          "errors": {
            "general": "Role masih digunakan oleh pengguna dan tidak dapat dinonaktifkan"
          }
        }
      }
    }
  },

  // ======================================================
  // RESTORE ROLE (Admin)
  // ======================================================
  "restore": {
    "method": "PATCH",
    "endpoint": "/api/v1/roles/:id/restore",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "parameters": {
      "path": {
        "id": "5"
      }
    },
    "notes": [
      "Memulihkan role yang di-soft-delete (Unscoped lookup, jadi bisa restore walau sudah terhapus)."
    ],
    "responses": {
      "200": {
        "description": "Role berhasil dipulihkan",
        "body": {
          "success": true,
          "code": "ROLE_RESTORED",
          "message": "role berhasil dipulihkan"
        }
      },
      "404": {
        "description": "Role tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Role tidak ditemukan"
        }
      }
    }
  },

  // ======================================================
  // DELETE ROLE (Admin)
  // ======================================================
  "delete": {
    "method": "DELETE",
    "endpoint": "/api/v1/roles/:id",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "parameters": {
      "path": {
        "id": "5"
      }
    },
    "notes": [
      "Soft delete (deleted_at diisi).",
      "Role sistem tidak bisa dihapus.",
      "Role yang masih dipakai user aktif tidak bisa dihapus."
    ],
    "responses": {
      "200": {
        "description": "Role berhasil dihapus",
        "body": {
          "success": true,
          "code": "ROLE_DELETED",
          "message": "role berhasil dihapus"
        }
      },
      "422": {
        "description": "Role sistem / masih dipakai user",
        "body": {
          "success": false,
          "code": "VALIDATION_ERROR",
          "message": "validasi gagal",
          "errors": {
            "general": "Role ini sedang digunakan oleh pengguna aktif dan tidak dapat dihapus"
          }
        }
      }
    }
  },

  // ======================================================
  // CEK KEUNIKAN ROLE (Admin)
  // ======================================================
  "check_unique": {
    "method": "GET",
    "endpoint": "/api/v1/roles/check-unique",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "parameters": {
      "query": {
        "field": "name",
        "value": "editor",
        "exclude_id": "0"
      }
    },
    "notes": [
      "field: name | display_name (di-validasi service; nilai lain → error validasi).",
      "exclude_id opsional: abaikan role dengan id ini (untuk update, agar role sendiri tidak dianggap duplikat).",
      "Response data.is_unique = true berarti field/value tersedia (tidak dipakai role lain).",
      "PENTING: route /check-unique didaftarkan SEBELUM /:id di router, jadi tidak tertangkap sebagai detail role."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengecek keunikan",
        "body": {
          "success": true,
          "code": "ROLE_UNIQUE_CHECK",
          "message": "berhasil mengecek keunikan",
          "data": {
            "is_unique": true
          }
        }
      },
      "422": {
        "description": "field/value wajib diisi atau field tidak valid",
        "body": {
          "success": false,
          "code": "VALIDATION_ERROR",
          "message": "validasi gagal",
          "errors": {
            "field": "field harus name atau display_name"
          }
        }
      }
    }
  },

  // ======================================================
  // INFO DEPENDENSI ROLE (Admin)
  // ======================================================
  "dependency_info": {
    "method": "GET",
    "endpoint": "/api/v1/roles/:id/dependency-info",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "notes": [
      "Digunakan frontend untuk konfirmasi sebelum hapus/nonaktifkan: berapa user aktif yang memakai role ini.",
      "Response 3 field: has_dependencies (true jika ada user aktif), message (deskripsi dependensi), user_count (jumlah user aktif)."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil info dependensi",
        "body": {
          "success": true,
          "code": "ROLE_DEPENDENCY_INFO",
          "message": "berhasil mengambil info dependensi",
          "data": {
            "has_dependencies": true,
            "message": "2 pengguna aktif",
            "user_count": 2
          }
        }
      },
      "404": {
        "description": "Role tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Role tidak ditemukan"
        }
      }
    }
  },

  // ======================================================
  // BULK DELETE ROLE (Admin)
  // ======================================================
  "bulk_delete": {
    "method": "POST",
    "endpoint": "/api/v1/roles/bulk-delete",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "request": {
      "ids": [5, 6]
    },
    "validation": {
      "ids": "required,min=1,array of uint"
    },
    "notes": [
      "Soft delete banyak role sekaligus.",
      "Role sistem atau yang dipakai user aktif di-skip (tidak dihapus) — per item, bukan gagal total."
    ],
    "responses": {
      "200": {
        "description": "Role terpilih berhasil dihapus",
        "body": {
          "success": true,
          "code": "ROLE_BULK_DELETED",
          "message": "role terpilih berhasil dihapus"
        }
      },
      "422": {
        "description": "ids wajib diisi",
        "body": {
          "success": false,
          "code": "VALIDATION_ERROR",
          "message": "validasi gagal",
          "errors": {
            "ids": "ids wajib diisi minimal 1"
          }
        }
      }
    }
  },

  // ======================================================
  // BULK RESTORE ROLE (Admin)
  // ======================================================
  "bulk_restore": {
    "method": "PATCH",
    "endpoint": "/api/v1/roles/bulk-restore",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "request": {
      "ids": [5, 6]
    },
    "validation": {
      "ids": "required,min=1,array of uint"
    },
    "notes": [
      "Memulihkan banyak role yang di-soft-delete sekaligus."
    ],
    "responses": {
      "200": {
        "description": "Role terpilih berhasil dipulihkan",
        "body": {
          "success": true,
          "code": "ROLE_BULK_RESTORED",
          "message": "role terpilih berhasil dipulihkan"
        }
      },
      "422": {
        "description": "ids wajib diisi",
        "body": {
          "success": false,
          "code": "VALIDATION_ERROR",
          "message": "validasi gagal",
          "errors": {
            "ids": "ids wajib diisi minimal 1"
          }
        }
      }
    }
  }
}
