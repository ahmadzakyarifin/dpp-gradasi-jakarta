{
  // =========================================================================
  // KONTRAK API - MODUL KEPENGURUSAN (CRUD tabel `pengurus`)
  // Mendukung level filter: ketua, dpp, dpd, dpc
  // =========================================================================

  // ======================================================
  // LIST PENGURUS (Public)
  // ======================================================
  "list_public": {
    "method": "GET",
    "endpoint": "/api/v1/pengurus",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "None"
    },
    "headers": {
      "Accept": "application/json"
    },
    "parameters": {
      "query": {
        "level": "dpp",            // ketua | dpp | dpd | dpc
        "provinsi": "Jawa Timur",
        "kabupaten": "Kota Surabaya",
        "search": "Kusbeni",
        "page": "1",
        "limit": "8",
        "sort": "sort_order"       // sort_order | name_asc | name_desc
      }
    },
    "notes": [
      "Hanya menampilkan pengurus yang is_active = true.",
      "Filter level wajib untuk menampilkan data per tingkat kepengurusan.",
      "Filter provinsi dan kabupaten hanya berlaku untuk level dpd dan dpc."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil daftar pengurus",
        "body": {
          "success": true,
          "code": "PENGURUS_LIST",
          "message": "Daftar pengurus berhasil diambil",
          "data": [
            {
              "id": 1,
              "name": "Upi Asmaradhana",
              "role": "Ketua Umum DPP",
              "department": "Pimpinan Pusat",
              "level": "dpp",
              "provinsi": null,
              "kabupaten": null,
              "image_url": "/uploads/pengurus/upi.jpg",
              "facebook_url": "#",
              "instagram_url": "#",
              "linkedin_url": "#",
              "whatsapp": "6285279880008",
              "periode": "2025 - 2030",
              "sort_order": 1
            }
          ],
          "meta": {
            "current_page": 1,
            "limit": 8,
            "total_data": 16,
            "total_pages": 2
          }
        }
      }
    }
  },

  // ======================================================
  // GET REGIONS (Daftar Wilayah untuk Filter)
  // ======================================================
  "regions": {
    "method": "GET",
    "endpoint": "/api/v1/pengurus/regions",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "None"
    },
    "headers": {
      "Accept": "application/json"
    },
    "notes": [
      "Mengambil daftar provinsi dan kabupaten yang memiliki pengurus.",
      "Digunakan frontend untuk mengisi dropdown filter wilayah."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil daftar wilayah",
        "body": {
          "success": true,
          "code": "PENGURUS_REGIONS",
          "message": "Daftar wilayah berhasil diambil",
          "data": {
            "provinsi": ["Aceh", "Bali", "Banten", "DKI Jakarta", "Jawa Timur"],
            "kabupaten": {
              "Jawa Timur": ["Kabupaten Malang", "Kota Surabaya", "Sidoarjo"]
            }
          }
        }
      }
    }
  },

  // ======================================================
  // LIST PENGURUS (Admin — semua status)
  // ======================================================
  "list_admin": {
    "method": "GET",
    "endpoint": "/api/v1/admin/pengurus",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "parameters": {
      "query": {
        "level": "dpp",
        "provinsi": "Jawa Timur",
        "search": "Kusbeni",
        "status": "active",        // active | inactive | all
        "page": "1",
        "limit": "10",
        "sort": "sort_order",
        "trashed": "false"
      }
    },
    "responses": {
      "200": {
        "description": "Berhasil mengambil daftar pengurus (admin)",
        "body": {
          "success": true,
          "code": "PENGURUS_LIST",
          "message": "Daftar pengurus berhasil diambil",
          "data": [
            {
              "id": 1,
              "name": "Upi Asmaradhana",
              "role": "Ketua Umum DPP",
              "department": "Pimpinan Pusat",
              "level": "dpp",
              "provinsi": null,
              "kabupaten": null,
              "image_url": "/uploads/pengurus/upi.jpg",
              "is_active": true,
              "periode": "2025 - 2030",
              "sort_order": 1,
              "created_at": "2026-01-01T08:00:00Z",
              "updated_at": "2026-01-01T08:00:00Z"
            }
          ],
          "meta": {
            "current_page": 1,
            "limit": 10,
            "total_data": 16,
            "total_pages": 2
          }
        }
      }
    }
  },

  // ======================================================
  // CREATE PENGURUS
  // ======================================================
  "create": {
    "method": "POST",
    "endpoint": "/api/v1/admin/pengurus",
    "consumes": "multipart/form-data",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "request": {
      "name": "Kusbeni Abdulloh, S.Kom.",
      "role": "Ketua DPD Gradasi Jawa Timur",
      "department": "",
      "level": "dpd",
      "provinsi": "Jawa Timur",
      "kabupaten": "",
      "image": "(File Upload)",
      "facebook_url": "#",
      "instagram_url": "#",
      "linkedin_url": "#",
      "whatsapp": "628123456789",
      "sort_order": "1",
      "periode": "2025 - 2030"
    },
    "validation": {
      "name": "required,min=3,max=150",
      "role": "required,max=200",
      "department": "max=100",
      "level": "required,oneof=ketua dpp dpd dpc",
      "provinsi": "required_if=level dpd,required_if=level dpc,max=100",
      "kabupaten": "required_if=level dpc,max=100",
      "image": "required",
      "facebook_url": "max=500",
      "instagram_url": "max=500",
      "linkedin_url": "max=500",
      "whatsapp": "max=20,numeric",
      "sort_order": "numeric",
      "periode": "required,max=50"
    },
    "notes": [
      "Field provinsi wajib diisi jika level = dpd atau dpc.",
      "Field kabupaten wajib diisi jika level = dpc.",
      "File image wajib dikirim saat create."
    ],
    "responses": {
      "201": {
        "description": "Pengurus berhasil ditambahkan",
        "body": {
          "success": true,
          "code": "PENGURUS_CREATED",
          "message": "Pengurus berhasil ditambahkan",
          "data": {
            "id": 5,
            "name": "Kusbeni Abdulloh, S.Kom."
          }
        }
      },
      "400": {
        "description": "Validasi input gagal",
        "body": {
          "success": false,
          "code": "VALIDATION_ERROR",
          "message": "validasi gagal",
          "errors": {
            "name": "Nama minimal 3 karakter",
            "provinsi": "Provinsi wajib diisi untuk level dpd/dpc",
            "kabupaten": "Kabupaten wajib diisi untuk level dpc"
          }
        }
      }
    }
  },

  // ======================================================
  // UPDATE PENGURUS
  // ======================================================
  "update": {
    "method": "PUT",
    "endpoint": "/api/v1/admin/pengurus/:id",
    "consumes": "multipart/form-data",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "parameters": {
      "path": {
        "id": "5"
      }
    },
    "request": {
      "name": "Kusbeni Abdulloh, S.Kom. (Updated)",
      "role": "Ketua DPD",
      "department": "",
      "level": "dpd",
      "provinsi": "Jawa Timur",
      "kabupaten": "",
      "image": "(File Upload - Opsional)",
      "facebook_url": "#",
      "instagram_url": "#",
      "linkedin_url": "#",
      "whatsapp": "628123456789",
      "sort_order": "1",
      "periode": "2025 - 2030",
      "is_active": "true"
    },
    "validation": {
      "name": "required,min=3,max=150",
      "role": "required,max=200",
      "department": "max=100",
      "level": "required,oneof=ketua dpp dpd dpc",
      "provinsi": "required_if=level dpd,required_if=level dpc,max=100",
      "kabupaten": "required_if=level dpc,max=100",
      "image": "omitempty",
      "facebook_url": "max=500",
      "instagram_url": "max=500",
      "linkedin_url": "max=500",
      "whatsapp": "max=20,numeric",
      "sort_order": "numeric",
      "periode": "required,max=50",
      "is_active": "required,boolean"
    },
    "responses": {
      "200": {
        "description": "Data pengurus berhasil diperbarui",
        "body": {
          "success": true,
          "code": "PENGURUS_UPDATED",
          "message": "Data pengurus berhasil diperbarui"
        }
      },
      "404": {
        "description": "Pengurus tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Pengurus tidak ditemukan"
        }
      }
    }
  },

  // ======================================================
  // DELETE PENGURUS (Soft Delete)
  // ======================================================
  "delete": {
    "method": "DELETE",
    "endpoint": "/api/v1/admin/pengurus/:id",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "parameters": {
      "path": {
        "id": "5"
      }
    },
    "responses": {
      "200": {
        "description": "Pengurus berhasil dihapus (soft delete)",
        "body": {
          "success": true,
          "code": "PENGURUS_DELETED",
          "message": "Pengurus berhasil dihapus"
        }
      },
      "404": {
        "description": "Pengurus tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Pengurus tidak ditemukan"
        }
      }
    }
  },

  // ======================================================
  // RESTORE PENGURUS
  // ======================================================
  "restore": {
    "method": "POST",
    "endpoint": "/api/v1/admin/pengurus/:id/restore",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "parameters": {
      "path": {
        "id": "5"
      }
    },
    "responses": {
      "200": {
        "description": "Pengurus berhasil dipulihkan",
        "body": {
          "success": true,
          "code": "PENGURUS_RESTORED",
          "message": "Pengurus berhasil dipulihkan"
        }
      }
    }
  },

    // ======================================================
    // BULK DELETE PENGURUS
    // ======================================================
    "bulk_delete": {
      "method": "POST",
      "endpoint": "/api/v1/admin/pengurus/bulk-delete",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "ids": [1, 2, 3]
      },
      "responses": {
        "200": {
          "description": "Bulk delete berhasil",
          "body": {
            "success": true,
            "code": "BULK_DELETED",
            "message": "Data berhasil dihapus (soft delete)."
          }
        }
      }
    },

    // ======================================================
    // BULK RESTORE PENGURUS
    // ======================================================
    "bulk_restore": {
      "method": "POST",
      "endpoint": "/api/v1/admin/pengurus/bulk-restore",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "ids": [1, 2, 3]
      },
      "responses": {
        "200": {
          "description": "Bulk restore berhasil",
          "body": {
            "success": true,
            "code": "BULK_RESTORED",
            "message": "Data berhasil dipulihkan."
          }
        }
      }
    }
}
