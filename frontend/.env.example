# API Configuration
# Development: http://127.0.0.1:8080/api/v1
# Production : https://api.domain.com/api/v1
VITE_API_URL=http://127.0.0.1:8080/api/v1

# Cloudflare Turnstile (CAPTCHA)
# VITE_CAPTCHA_ENABLED:
#   - development: false (backend CAPTCHA_ENABLED=false juga, tanpa verifikasi)
#   - production : true + VITE_CAPTCHA_SITE_KEY dari Cloudflare Dashboard
# VITE_CAPTCHA_SITE_KEY adalah SITE KEY publik (aman untuk frontend).
VITE_CAPTCHA_ENABLED=true
VITE_CAPTCHA_SITE_KEY=0x4AAAAAAEDe3XqhMzghG4b9
