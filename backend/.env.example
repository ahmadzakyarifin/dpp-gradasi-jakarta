# ============================================================
# DPP Gradasi — Backend Configuration (copy ke .env lalu isi)
# Salin: cp .env.example .env
# JANGAN commit .env (sudah di .gitignore)
# ============================================================

# --- Aplikasi ---
APP_NAME=DPP GRADASI
APP_ENV=development
APP_URL=http://localhost:8080
PORT=8080
# Whitelist origin CORS, comma-separated. Production: ganti ke domain frontend.
ALLOWED_ORIGINS=http://localhost:5173

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dpp_gradasi_jakarta
DB_USER=root
DB_PASS=

# --- JWT ---
# WAJIB: minimal 32 karakter di production
JWT_SECRET=ubah-saya-menjadi-string-acak-minimal-32-karakter
JWT_ACCESS_TTL_MINS=60
JWT_REFRESH_TTL_HOURS=168
JWT_REMEMBER_ME_TTL_HOURS=720

# --- Password Reset ---
PASSWORD_RESET_TTL_MINS=30

# --- Cookie ---
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_PATH=/

# --- Cloudflare Turnstile CAPTCHA ---
# Site key publik (aman untuk frontend), secret key rahasia.
# CAPTCHA_ENABLED=true mewajibkan CAPTCHA_SECRET_KEY terisi (app fail-fast).
CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=0x0000000000000000000000
CAPTCHA_SECRET_KEY=
# dev: http://localhost:3000 — prod: https://challenges.cloudflare.com
CAPTCHA_VERIFY_URL=http://localhost:3000

# --- SMTP (kirim email aktivasi/reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASS=
SMTP_FROM_NAME=DPP GRADASI

# --- Seeder Superadmin ---
# Dipakai saat migration/seed pertama kali jalan
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@gradasi.org
SUPERADMIN_PASSWORD=GantiSandiIni123!
