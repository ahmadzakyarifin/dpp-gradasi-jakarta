{
  // =========================================================================
  // KONTRAK API - MODUL DASHBOARD (Ringkasan Admin)
  // Endpoint prefix: /api/v1/admin/dashboard
  // Hak Akses: Bearer Access Token (Hanya Super Admin / super_admin)
  // =========================================================================

  // ======================================================
  // SUMMARY DASHBOARD (Super Admin Only)
  // ======================================================
  "summary": {
    "method": "GET",
    "endpoint": "/api/v1/admin/dashboard/summary",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin"]
    },
    "notes": [
      "Ringkasan statistik untuk halaman dashboard admin.",
      "Menghitung total entity (berita, kegiatan, pengurus, kontak, admin) + ringkasan activity log.",
      "pending_admin = jumlah akun admin pengelola berstatus 'pending_activation' (belum aktivasi via email)."
    ],
    "responses": {
      "200": {
        "description": "Ringkasan dashboard berhasil diambil",
        "body": {
          "success": true,
          "code": "DASHBOARD_SUMMARY",
          "message": "Ringkasan dashboard berhasil diambil",
          "data": {
            "total_berita": 128,
            "total_kegiatan": 45,
            "total_pengurus": 340,
            "total_kontak": 12,
            "unread_kontak": 5,
            "total_admin": 8,
            "pending_admin": 2,
            "activity_logs": 512,
            "high_risk_logs": 4,
            "failed_login": 2,
            "cms_actions": 86
          }
        }
      },
      "401": {
        "description": "Token tidak valid atau kadaluarsa",
        "body": {
          "success": false,
          "code": "UNAUTHORIZED",
          "message": "Akses ditolak. Token tidak valid."
        }
      },
      "403": {
        "description": "Bukan Super Admin",
        "body": {
          "success": false,
          "code": "FORBIDDEN",
          "message": "Akses ditolak. Hanya Super Admin yang diizinkan."
        }
      }
    }
  }
}
