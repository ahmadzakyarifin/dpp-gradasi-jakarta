{
  // =========================================================================
  // KONTRAK API - MODUL USER (PROFIL & ADMIN SEDERHANA)
  // Endpoint prefix: /api/v1/profile & /api/v1/admin/users
  // Hak Akses: Bearer Access Token
  // =========================================================================

  "profile": {
    // ======================================================
    // GET PROFILE (Admin yang sedang login)
    // ======================================================
    "get": {
      "method": "GET",
      "endpoint": "/api/v1/profile",
      "consumes": null,
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "notes": [
        "Mengambil data profil milik pengguna yang sedang login berdasarkan JWT Token."
      ],
      "responses": {
        "200": {
          "description": "Berhasil mengambil profil",
          "body": {
            "success": true,
            "code": "PROFILE_RETRIEVED",
            "message": "Profil berhasil diambil",
            "data": {
              "id": 1,
              "role_id": 1,
              "name": "Administrator",
              "email": "admin@gradasi.org",
              "photo_path": "/uploads/users/123456789.png",
              "status": "active"
            }
          }
        }
      }
    },

    // ======================================================
    // UPDATE PROFILE
    // ======================================================
    "update": {
      "method": "PUT",
      "endpoint": "/api/v1/profile",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Content-Type": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "name": "Administrator Baru"
      },
      "validation": {
        "name": "required,min=2,max=100"
      },
      "notes": [
        "Update nama profil milik sendiri (handler hanya membaca field name — lihat UserHandler.UpdateProfile).",
        "Email TIDAK bisa diubah oleh user sendiri — dikelola admin melalui modul user management (admin/users).",
        "Foto profil juga tidak dikelola lewat endpoint ini (photo_path dikelola admin)."
      ],
      "responses": {
        "200": {
          "description": "Profil berhasil diupdate",
          "body": {
            "success": true,
            "code": "PROFILE_UPDATED",
            "message": "Profil berhasil diperbarui",
            "data": {
              "id": 1,
              "role_id": 1,
              "name": "Administrator Baru",
              "email": "admin@gradasi.org",
              "photo_path": "/uploads/users/123456789.png",
              "status": "active"
            }
          }
        },
        "422": {
          "description": "Body JSON tidak valid (name kosong/format salah)",
          "body": {
            "success": false,
            "code": "VALIDATION_ERROR",
            "message": "validasi gagal",
            "errors": [
              { "field": "name", "tag": "required", "message": "Key: 'ProfileUpdateRequest.Name' Error:Field validation for 'Name' failed on the 'required' tag" }
            ]
          }
        }
      }
    },

    // ======================================================
    // VERIFY EMAIL CHANGE
    // ======================================================
    "verify_email": {
      "method": "POST",
      "endpoint": "/api/v1/profile/verify-email",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "token": "0c4e2f9a-8b3d-4f5e-9a1c-2d3e4f5a6b7c"
      },
      "validation": {
        "token": "required"
      },
      "notes": [
        "Menandai email akun saat ini sebagai terverifikasi (set email_verified_at). BUKAN untuk ganti email — email dikelola admin melalui user management.",
        "Token berupa UUID (dari helper.GenerateActivationToken) yang dikirim sistem ke email, disimpan di database tabel activation_tokens (bukan Redis).",
        "Token berlaku 72 jam sejak dibuat; setelah dipakai, token dihapus."
      ],
      "responses": {
        "200": {
          "description": "Email berhasil diverifikasi",
          "body": {
            "success": true,
            "code": "EMAIL_VERIFIED",
            "message": "Email berhasil diverifikasi"
          }
        }
      }
    },

    // ======================================================
    // CHANGE PASSWORD (Profil Sendiri)
    // ======================================================
    "change_password": {
      "method": "PUT",
      "endpoint": "/api/v1/profile/password",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "old_password": "passwordlama123",
        "new_password": "passwordbaru123"
      },
      "validation": {
        "old_password": "required",
        "new_password": "required,min=6"
      },
      "notes": [
        "Mengganti password akun sendiri. Wajib menyertakan password lama.",
        "Setelah berhasil, flag must_change_password di-reset ke false dan semua refresh token user dihapus (logout dari semua perangkat)."
      ],
      "responses": {
        "200": {
          "description": "Password berhasil diubah",
          "body": {
            "success": true,
            "code": "PASSWORD_CHANGED",
            "message": "Password berhasil diubah"
          }
        },
        "400": {
          "description": "Password lama salah",
          "body": {
            "success": false,
            "code": "INVALID_PASSWORD",
            "message": "Password lama salah"
          }
        }
      }
    }
  },

  "admin_management": {
    // ======================================================
    // GET ALL ADMINS (Hanya Super Admin)
    // ======================================================
    "get_all": {
      "method": "GET",
      "endpoint": "/api/v1/admin/users",
      "consumes": null,
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "security": {
        "roles": ["super_admin"]
      },
      "parameters": {
        "query": {
          "tab": "active | pending | trash (default active)",
          "search": "cari nama / email",
          "page": "halaman (default 1)",
          "limit": "jumlah per halaman (default 10, max 100)"
        }
      },
      "notes": [
        "Menampilkan daftar seluruh admin dengan filter tab, pencarian, dan pagination.",
        "tab=active: status != pending_activation; tab=pending: status = pending_activation; tab=trash: soft-deleted.",
        "Hanya user dengan role Super Admin (super_admin) yang dapat mengakses ini."
      ],
      "responses": {
        "200": {
          "description": "Berhasil mengambil daftar admin",
          "body": {
            "success": true,
            "code": "ADMIN_LIST",
            "message": "Daftar admin berhasil diambil",
            "data": {
              "items": [
                {
                  "id": 1,
                  "role_id": 1,
                  "role": "super_admin",
                  "name": "Administrator",
                  "email": "admin@gradasi.org",
                  "status": "active",
                  "must_change_password": false
                },
                {
                  "id": 2,
                  "role_id": 2,
                  "role": "admin",
                  "name": "Admin Divisi IT",
                  "email": "it@gradasi.org",
                  "status": "active",
                  "must_change_password": true
                }
              ],
              "meta": {
                "current_page": 1,
                "limit": 10,
                "total_data": 2,
                "total_pages": 1
              }
            }
          }
        }
      }
    },

    // ======================================================
    // INVITE ADMIN (Hanya Super Admin)
    // ======================================================
    "create": {
      "method": "POST",
      "endpoint": "/api/v1/admin/users",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "name": "Admin Baru",
        "email": "baru@gradasi.org",
        "role_id": 2
      },
      "validation": {
        "name": "required,min=3,max=100",
        "email": "required,email,max=150",
        "role_id": "required,numeric,exists=roles.id" // divalidasi terhadap tabel roles (FK), bukan whitelist id statis
      },
      "notes": [
        "Membuat akun admin baru. Super Admin tidak perlu menginput password.",
        "Sistem membuat password default acak (10 karakter) dan mengirimkannya beserta email via email kredensial.",
        "Admin baru bisa langsung login dengan email + password default tersebut, lalu WAJIB mengganti password pada login pertama (must_change_password=true).",
        "Email kredensial dikirim secara sinkron: jika SMTP gagal, akun tidak jadi dibuat (rollback) dan response error MAIL_SEND_FAILED.",
        "role_id divalidasi terhadap tabel `roles` (foreign key `users.role_id -> roles.id`), bukan daftar id statis di aplikasi. Jika role_id tidak ditemukan di tabel roles -> 422 VALIDATION_ERROR."
      ],
      "responses": {
        "201": {
          "description": "Admin berhasil dibuat & kredensial terkirim",
          "body": {
            "success": true,
            "code": "ADMIN_CREATED",
            "message": "Admin berhasil dibuat. Kredensial login (email & password default) telah dikirim ke email admin.",
            "data": {
              "id": 3,
              "role_id": 2,
              "role": "admin",
              "name": "Admin Baru",
              "email": "baru@gradasi.org",
              "status": "active",
              "must_change_password": true
            }
          }
        }
      }
    },

    // ======================================================
    // DELETE ADMIN (Hanya Super Admin)
    // ======================================================
    "delete": {
      "method": "DELETE",
      "endpoint": "/api/v1/admin/users/:id",
      "consumes": null,
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "notes": [
        "Menghapus (soft delete) akun admin lain.",
        "Admin tidak dapat menghapus akunnya sendiri ataupun akun Super Admin lainnya (role_id 1).",
        "Super Admin TIDAK BISA dihapus (baik single maupun massal)."
      ],
      "responses": {
        "200": {
          "description": "Admin berhasil dihapus",
          "body": {
            "success": true,
            "code": "ADMIN_DELETED",
            "message": "Admin berhasil dihapus"
          }
        }
      }
    },

    // ======================================================
    // RESTORE ADMIN
    // ======================================================
    "restore": {
      "method": "POST",
      "endpoint": "/api/v1/admin/users/:id/restore",
      "consumes": null,
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "responses": {
        "200": {
          "description": "Admin berhasil dipulihkan",
          "body": {
            "success": true,
            "code": "ADMIN_RESTORED",
            "message": "Admin berhasil dipulihkan."
          }
        }
      }
    },

    // ======================================================
    // BULK DELETE ADMIN
    // ======================================================
    "bulk_delete": {
      "method": "POST",
      "endpoint": "/api/v1/admin/users/bulk-delete",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "ids": [1, 2, 3]
      },
      "responses": {
        "200": {
          "description": "Bulk delete berhasil",
          "body": {
            "success": true,
            "code": "ADMIN_BULK_DELETED",
            "message": "Admin berhasil dihapus massal"
          }
        }
      }
    },

    // ======================================================
    // BULK RESTORE ADMIN
    // ======================================================
    "bulk_restore": {
      "method": "POST",
      "endpoint": "/api/v1/admin/users/bulk-restore",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "ids": [1, 2, 3]
      },
      "responses": {
        "200": {
          "description": "Bulk restore berhasil",
          "body": {
            "success": true,
            "code": "ADMIN_BULK_RESTORED",
            "message": "Admin berhasil dipulihkan massal"
          }
        }
      }
    },

    // ======================================================
    // RESEND ACTIVATION (Hanya Super Admin)
    // ======================================================
    "resend_activation": {
      "method": "POST",
      "endpoint": "/api/v1/admin/users/:id/resend-activation",
      "consumes": null,
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "notes": [
        "Mengirim ulang email kredensial login (password default baru) ke admin.",
        "Password default baru dibuat acak, status akun tetap active, dan must_change_password diset true.",
        "Tidak berlaku untuk super_admin (role_id 1): error FORBIDDEN."
      ],
      "responses": {
        "200": {
          "description": "Undangan aktivasi dikirim ulang",
          "body": {
            "success": true,
            "code": "ACTIVATION_RESENT",
            "message": "Undangan aktivasi berhasil dikirim ulang ke email admin."
          }
        },
        "400": {
          "description": "Admin tidak dalam status pending_activation",
          "body": {
            "success": false,
            "code": "BAD_REQUEST",
            "message": "Hanya akun dengan status Menunggu Aktivasi yang bisa dikirimi undangan ulang"
          }
        }
      }
    },

    // ======================================================
    // UPDATE ADMIN STATUS (Hanya Super Admin)
    // ======================================================
    "get_by_id": {
      "method": "GET",
      "endpoint": "/api/v1/admin/users/:id",
      "consumes": null,
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "roles": ["super_admin"],
      "notes": [
        "Mengambil detail satu admin berdasarkan ID. Endpoint ini ada di implementasi backend dan didokumentasikan di sini supaya tidak undocumented."
      ],
      "responses": {
        "200": {
          "description": "Detail admin berhasil diambil",
          "body": {
            "success": true,
            "code": "USER_DETAIL",
            "message": "berhasil mengambil data user",
            "data": {
              "user": {
                "id": 2,
                "role_id": 2,
                "role": "admin",
                "name": "Admin Sekretariat",
                "email": "admin@gradasi.org",
                "photo_path": null,
                "status": "active",
                "must_change_password": false
              }
            }
          }
        }
      }
    },
    "update_status": {
      "method": "PUT",
      "endpoint": "/api/v1/admin/users/:id/status",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "status": "inactive"
      },
      "validation": {
        "status": "required,oneof=active inactive"
      },
      "notes": [
        "Mengubah status admin pengelola: active atau inactive (non-aktif oleh super admin).",
        "Status 'pending_activation' TIDAK bisa diubah ke 'active' langsung — akun harus aktivasi lewat link email dulu.",
        "Super admin (role_id 1) tidak bisa diubah statusnya: error FORBIDDEN."
      ],
      "responses": {
        "200": {
          "description": "Status admin berhasil diperbarui",
          "body": {
            "success": true,
            "code": "ADMIN_STATUS_UPDATED",
            "message": "Status admin berhasil diperbarui"
          }
        },
        "400": {
          "description": "Akun belum aktivasi",
          "body": {
            "success": false,
            "code": "BAD_REQUEST",
            "message": "Akun belum melakukan aktivasi. Kirim ulang undangan aktivasi terlebih dahulu."
          }
        }
      }
    }
  }
}
