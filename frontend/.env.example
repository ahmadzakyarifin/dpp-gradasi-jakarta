# API Configuration
# Development: http://127.0.0.1:8080/api/v1
# Production : https://api.domain.com/api/v1
VITE_API_URL=http://127.0.0.1:8080/api/v1

# Cloudflare Turnstile (CAPTCHA)
# CATATAN (2026-08): status CAPTCHA sekarang dibaca dari backend via GET /settings
# (single source of truth) — frontend TIDAK perlu VITE_CAPTCHA_ENABLED lagi.
# VITE_CAPTCHA_SITE_KEY di sini hanya fallback development; key asli disimpan
# di env backend (CAPTCHA_SITE_KEY) dan dikirim ke FE lewat /settings.
# Jangan commit site key asli ke .env.example — pakai placeholder.
VITE_CAPTCHA_SITE_KEY=0x0000000000000000000000
