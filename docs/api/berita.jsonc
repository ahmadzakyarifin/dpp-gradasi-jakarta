{
  // =========================================================================
  // KONTRAK API - MODUL BERITA (CRUD tabel `berita` & `berita_tags`)
  // Relasi: author_id (User ID) -> users(id)
  // Slug dibuat otomatis dari `title` oleh backend (via gosimple/slug).
  // Soft delete — kolom `deleted_at`.
  // =========================================================================

  // ======================================================
  // LIST BERITA (Public — hanya published)
  // ======================================================
  "list_public": {
    "method": "GET",
    "endpoint": "/api/v1/berita",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "None"
    },
    "headers": {
      "Accept": "application/json"
    },
    "parameters": {
      "query": {
        "page": "1",
        "limit": "6",
        "search": "Rakorda",
        "category": "Berita Organisasi",
        "tag": "Nasional",
        "sort": "newest",          // newest | oldest | most_viewed
        "status": "published"      // published | draft | trashed (admin)
      }
    },
    "notes": [
      "Hanya menampilkan berita yang is_published = true.",
      "Mendukung paginasi dan pencarian berdasarkan judul/konten.",
      "Mendukung filter kategori, tag, dan pengurutan."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil daftar berita",
        "body": {
          "success": true,
          "code": "BERITA_LIST",
          "message": "Daftar berita berhasil diambil.",
          "data": {
            "berita": [
              {
                "id": 1,
                "title": "Rapat Kerja Daerah Jatim",
                "slug": "rapat-kerja-daerah-jatim",
                "category": "Berita Organisasi",
                "published_date": "2026-02-11",
                "image_path": "/uploads/berita/17708152730.jpg",
                "excerpt": "SURABAYA, Generasi Digital Indonesia (GRADASI) Jawa Timur...",
                "is_featured": false,
                "views": 120,
                "created_at": "2026-02-11T08:00:00Z",
                "updated_at": "2026-02-11T08:00:00Z"
              }
            ],
            "meta": {
              "current_page": 1,
              "limit": 6,
              "total_data": 18,
              "total_pages": 3
            }
          }
        }
      }
    }
  },

  // ======================================================
  // LIST KATEGORI BERITA (Public — distinct categories)
  // ======================================================
  "list_categories": {
    "method": "GET",
    "endpoint": "/api/v1/berita/categories",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "None"
    },
    "headers": {
      "Accept": "application/json"
    },
    "parameters": {
      "query": {}
    },
    "notes": [
      "Mengembalikan daftar kategori unik (non-kosong) dari data berita aktif (deleted_at IS NULL).",
      "Dipakai FE untuk dropdown filter kategori & opsi '+ Buat Kategori Baru' di admin."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil daftar kategori",
        "body": {
          "success": true,
          "code": "BERITA_CATEGORIES",
          "message": "Daftar kategori berita berhasil diambil.",
          "data": ["Berita Daerah", "Berita Organisasi", "Berita Utama", "Edukasi"]
        }
      }
    }
  },

  // ======================================================
  // DETAIL BERITA (Public — by slug)
  // ======================================================
  "detail_public": {
    "method": "GET",
    "endpoint": "/api/v1/berita/:slug",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "None"
    },
    "headers": {
      "Accept": "application/json"
    },
    "parameters": {
      "path": {
        "slug": "rapat-kerja-daerah-jatim"
      }
    },
    "notes": [
      "Mengambil detail lengkap berita berdasarkan slug.",
      "Views counter otomatis bertambah setiap kali diakses."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil detail berita",
        "body": {
          "success": true,
          "code": "BERITA_DETAIL",
          "message": "Detail berita berhasil diambil.",
          "data": {
            "id": 1,
            "title": "Rapat Kerja Daerah Jatim",
            "slug": "rapat-kerja-daerah-jatim",
            "category": "Berita Organisasi",
            "published_date": "2026-02-11",
            "author_name": "Administrator",
            "image_path": "/uploads/berita/17708152730.jpg",
            "excerpt": "SURABAYA, Generasi Digital Indonesia...",
            "content": "<p>Konten berita lengkap dalam format HTML dari editor...</p>",
            "is_featured": false,
            "is_published": true,
            "views": 121,
            "tags": ["Rapat Kerja", "Jawa Timur", "GRADASI"],
            "created_at": "2026-02-11T08:00:00Z"
          }
        }
      },
      "404": {
        "description": "Berita tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Berita tidak ditemukan."
        }
      }
    }
  },

  // ======================================================
  // LIST BERITA (Admin — semua status)
  // ======================================================
  "list_admin": {
    "method": "GET",
    "endpoint": "/api/v1/berita/admin",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "rate_limit": {
        "enabled": true,
        "key": "User",
        "limit": "30 request / menit"
      },
      "roles": ["super_admin", "admin", "admin_berita"]
    },
    "parameters": {
      "query": {
        "page": "1",
        "limit": "10",
        "search": "Rakorda",
        "category": "Berita Organisasi",
        "tag": "Nasional",
        "status": "published",     // published | draft | trashed | all
        "sort": "newest"           // newest | oldest | most_viewed
      }
    },
    "notes": [
      "Menampilkan semua berita termasuk draft dan yang sudah dihapus (trashed).",
      "Hanya bisa diakses oleh user dengan role super_admin, admin, atau admin_berita.",
      "PENTING: field is_published TIDAK disertakan di response list (baik public maupun admin) — backend belum mengisi field ini di list item (beda dengan modul kegiatan yang sudah menyertakannya). Gunakan parameter query 'status' untuk mengetahui kelompok data yang sedang ditampilkan, atau panggil detail_admin per item jika perlu status pasti."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil daftar berita (admin)",
        "body": {
          "success": true,
          "code": "BERITA_LIST",
          "message": "Daftar berita berhasil diambil.",
          "data": {
            "berita": [
              {
                "id": 1,
                "title": "Rapat Kerja Daerah Jatim",
                "slug": "rapat-kerja-daerah-jatim",
                "category": "Berita Organisasi",
                "published_date": "2026-02-11",
                "author_name": "Administrator",
                "image_path": "/uploads/berita/17708152730.jpg",
                "excerpt": "SURABAYA, Generasi Digital Indonesia...",
                "is_featured": false,
                "views": 120,
                "created_at": "2026-02-11T08:00:00Z",
                "updated_at": "2026-02-11T08:00:00Z"
              }
            ],
            "meta": {
              "current_page": 1,
              "limit": 10,
              "total_data": 18,
              "total_pages": 2
            }
          }
        }
      }
    }
  },

  // ======================================================
  // DETAIL BERITA (Admin — by ID)
  // ======================================================
  "detail_admin": {
    "method": "GET",
    "endpoint": "/api/v1/berita/id/:id",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin", "admin_berita"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "responses": {
      "200": { "description": "Detail berita berdasarkan ID (sama struktur dengan detail_public)" },
      "404": { "description": "Berita tidak ditemukan" }
    }
  },

  // ======================================================
  // CREATE BERITA (Admin/Editor)
  // ======================================================
  "create": {
    "method": "POST",
    "endpoint": "/api/v1/berita",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "rate_limit": {
        "enabled": true,
        "key": "User",
        "limit": "30 request / menit"
      },
      "roles": ["super_admin", "admin", "admin_berita"]
    },
    "request": {
      "title": "Rapat Kerja Daerah Jatim",
      "category": "Berita Organisasi",
      "published_date": "2026-02-11",
      "author_id": 1,
      "image_path": "https://images.unsplash.com/photo-xxx",
      "excerpt": "SURABAYA, Generasi Digital Indonesia...",
      "content": "<p>Konten HTML dari editor...</p>",
      "is_featured": false,
      "is_published": true,
      "tags": "Rapat Kerja,Jawa Timur,GRADASI"
    },
    "validation": {
      "title": [
        { "tag": "required", "message": "Title wajib diisi, minimal 5 karakter." },
        { "tag": "min", "message": "Title minimal 5 karakter." },
        { "tag": "max", "message": "Title maksimal 300 karakter." }
      ],
      "content": [
        { "tag": "required", "message": "Content wajib diisi." }
      ],
      "published_date": [
        { "tag": "required", "message": "Published date wajib diisi." }
      ]
    },
    "notes": [
      "Slug dibuat otomatis dari title oleh backend (gosimple/slug).",
      "Judul duplikat (sudah dipakai berita lain, termasuk di sampah) → 422 DUPLICATE_TITLE.",
      "author_id bersifat opsional. Jika tidak diisi, diambil otomatis dari token login.",
      "Field tags dikirim sebagai string dipisahkan koma.",
      "Body JSON biasa — image_path cukup string path file, bukan upload file."
    ],
    "responses": {
      "201": {
        "description": "Berita berhasil dibuat",
        "body": {
          "success": true,
          "code": "BERITA_CREATED",
          "message": "Berita berhasil diterbitkan.",
          "data": {
            "id": 1,
            "title": "Rapat Kerja Daerah Jatim",
            "slug": "rapat-kerja-daerah-jatim",
            "category": "Berita Organisasi",
            "published_date": "2026-02-11",
            "image_path": "https://images.unsplash.com/photo-xxx",
            "excerpt": "SURABAYA, Generasi Digital Indonesia...",
            "content": "<p>Konten HTML dari editor...</p>",
            "is_featured": false,
            "is_published": true,
            "views": 0,
            "tags": ["Rapat Kerja", "Jawa Timur", "GRADASI"],
            "created_at": "2026-02-11T08:00:00Z"
          }
        }
      },
      "422": {
        "description": "Validasi gagal (dua kemungkinan body: error validasi field dari binding request, atau judul duplikat dari business rule).",
        "body": {
          "success": false,
          "code": "VALIDATION_ERROR",
          "message": "Validasi gagal.",
          "errors": [
            {
              "field": "title",
              "tag": "required",
              "message": "Title wajib diisi, minimal 5 karakter."
            }
          ]
        },
        "alt_body_duplicate_title": {
          "success": false,
          "code": "DUPLICATE_TITLE",
          "message": "Judul sudah digunakan, gunakan judul lain."
        }
      },
      "401": {
        "description": "Token tidak valid",
        "body": {
          "success": false,
          "code": "AUTH_TOKEN_INVALID_OR_EXPIRED",
          "message": "Sesi login telah berakhir. Silakan login kembali."
        }
      }
    }
  },

  // ======================================================
  // UPDATE BERITA (Admin/Editor)
  // ======================================================
  "update": {
    "method": "PUT",
    "endpoint": "/api/v1/berita/:id",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "rate_limit": {
        "enabled": true,
        "key": "User",
        "limit": "30 request / menit"
      },
      "roles": ["super_admin", "admin", "admin_berita"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "request": {
      "title": "Rapat Kerja Daerah Jatim (Update)",
      "category": "Berita Organisasi",
      "published_date": "2026-02-11",
      "author_id": 1,
      "image_path": "https://images.unsplash.com/photo-yyy",
      "excerpt": "Excerpt baru...",
      "content": "<p>Konten baru...</p>",
      "is_featured": true,
      "is_published": true,
      "tags": "Rakerda,Jatim,GRADASI"
    },
    "validation": {
      "title": [
        { "tag": "omitempty", "message": "Title bersifat opsional saat update." },
        { "tag": "min", "message": "Jika diisi, title minimal 5 karakter." },
        { "tag": "max", "message": "Title maksimal 300 karakter." }
      ]
    },
    "notes": [
      "Partial update — hanya field yang dikirim yang diubah (misal toggle publish cukup kirim {\\\"is_published\\\": false}).",
      "Title (jika dikirim) divalidasi min=5,max=300, tapi tidak wajib diisi. Field content TIDAK divalidasi (tidak ada binding required) di endpoint update, berbeda dengan create.",
      "Judul duplikat → 422 DUPLICATE_TITLE (judul berita lain).",
      "Slug TIDAK berubah saat update (link lama tidak mati)."
    ],
    "responses": {
      "200": {
        "description": "Berita berhasil diperbarui",
        "body": {
          "success": true,
          "code": "BERITA_UPDATED",
          "message": "Berita berhasil diperbarui.",
          "data": {
            "id": 1,
            "title": "Rapat Kerja Daerah Jatim (Update)",
            "slug": "rapat-kerja-daerah-jatim-update",
            "category": "Berita Organisasi",
            "published_date": "2026-02-11",
            "excerpt": "Excerpt baru...",
            "content": "<p>Konten baru...</p>",
            "is_featured": true,
            "is_published": true,
            "views": 1,
            "tags": ["Rakerda", "Jatim", "GRADASI"],
            "created_at": "2026-02-11T08:00:00Z"
          }
        }
      },
      "404": {
        "description": "Berita tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Berita tidak ditemukan."
        }
      },
      "422": {
        "description": "Validasi gagal (dua kemungkinan body: error validasi field, atau judul duplikat).",
        "body": {
          "success": false,
          "code": "VALIDATION_ERROR",
          "message": "Validasi gagal.",
          "errors": [
            { "field": "title", "tag": "min", "message": "Title minimal 5 karakter." }
          ]
        },
        "alt_body_duplicate_title": {
          "success": false,
          "code": "DUPLICATE_TITLE",
          "message": "Judul sudah digunakan, gunakan judul lain."
        }
      }
    }
  },

  // ======================================================
  // DELETE BERITA (Soft Delete — Admin/Editor)
  // ======================================================
  "delete": {
    "method": "DELETE",
    "endpoint": "/api/v1/berita/:id",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin", "admin_berita"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "notes": [
      "Soft delete — kolom deleted_at diisi, data masih di DB.",
      "Bisa dipulihkan via endpoint restore."
    ],
    "responses": {
      "200": {
        "description": "Berita berhasil dihapus",
        "body": {
          "success": true,
          "code": "BERITA_DELETED",
          "message": "Berita berhasil dihapus."
        }
      },
      "404": {
        "description": "Berita tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Berita tidak ditemukan."
        }
      }
    }
  },

  // ======================================================
  // RESTORE BERITA (Admin/Editor)
  // ======================================================
  "restore": {
    "method": "POST",
    "endpoint": "/api/v1/berita/:id/restore",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin", "admin_berita"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "responses": {
      "200": {
        "description": "Berita berhasil dipulihkan",
        "body": {
          "success": true,
          "code": "BERITA_RESTORED",
          "message": "Berita berhasil dipulihkan."
        }
      }
    }
  },

    // ======================================================
    // BULK DELETE BERITA
    // ======================================================
    "bulk_delete": {
      "method": "POST",
      "endpoint": "/api/v1/berita/bulk-delete",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "ids": [1, 2, 3]
      },
      "responses": {
        "200": {
          "description": "Bulk delete berhasil",
          "body": {
            "success": true,
            "code": "BERITA_BULK_DELETED",
            "message": "Berita berhasil dihapus massal."
          }
        }
      }
    },

    // ======================================================
    // BULK RESTORE BERITA
    // ======================================================
    "bulk_restore": {
      "method": "POST",
      "endpoint": "/api/v1/berita/bulk-restore",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "ids": [1, 2, 3]
      },
      "responses": {
        "200": {
          "description": "Bulk restore berhasil",
          "body": {
            "success": true,
            "code": "BERITA_BULK_RESTORED",
            "message": "Berita berhasil dipulihkan massal."
          }
        }
      }
    }
}
