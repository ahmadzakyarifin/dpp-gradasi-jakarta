# ==================================================
# DPP Gradasi Jakarta — BACKEND ENV (Development)
# Dibaca oleh: backend/cmd/api/main.go (godotenv: ../.env) + Makefile (root)
# Sumber key: backend/config/*.go (caarlos0/env v11)
# ==================================================

# --- App ---
APP_NAME="DPP Gradasi"
APP_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173

# [PILIHAN 1] Mode Lokal (Default)
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# [PILIHAN 2] Mode Ngrok (Buka tanda pagar '#' untuk mengaktifkan, dan ganti dengan URL Ngrok Anda)
# APP_URL=https://splotchy-waking-outcome.ngrok-free.dev
# FRONTEND_URL=https://splotchy-waking-outcome.ngrok-free.dev

# --- Database (MariaDB lokal) ---
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1
DB_NAME=dpp_new

# --- JWT ---
JWT_SECRET=ubah-ini-dengan-secret-panjang-minimal-32-karakter
JWT_ACCESS_TTL_MINS=15
JWT_REFRESH_TTL_HOURS=72
JWT_REMEMBER_ME_TTL_HOURS=720
PASSWORD_RESET_TTL_MINS=15

# --- Cookie ---
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_PATH=/api/v1/auth


# --- SMTP (email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASS=
SMTP_FROM_NAME="DPP Gradasi"
