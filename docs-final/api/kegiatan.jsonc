{
  // =========================================================================
  // KONTRAK API - MODUL KEGIATAN
  // CRUD tabel `kegiatan`, `kegiatan_tags`, dan `kegiatan_gallery`
  // Slug dibuat otomatis dari `title` oleh backend (via gosimple/slug).
  // Soft delete — kolom `deleted_at`.
  // =========================================================================

  // ======================================================
  // LIST KEGIATAN (Public — hanya published)
  // ======================================================
  "list_public": {
    "method": "GET",
    "endpoint": "/api/v1/kegiatan",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "None"
    },
    "headers": {
      "Accept": "application/json"
    },
    "parameters": {
      "query": {
        "page": "1",
        "limit": "6",
        "search": "bantuan",
        "category": "Kegiatan",
        "sort": "newest",           // newest | oldest | most_viewed
        "status": "published"      // published | draft | trashed (admin)
      }
    },
    "notes": [
      "Hanya menampilkan kegiatan yang is_published = true.",
      "Mendukung paginasi, pencarian, dan filter kategori."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil daftar kegiatan",
        "body": {
          "success": true,
          "code": "KEGIATAN_LIST",
          "message": "Daftar kegiatan berhasil diambil.",
          "data": {
            "kegiatan": [
              {
                "id": 1,
                "title": "Penyaluran Bantuan Kemanusiaan oleh DPP GRADASI",
                "slug": "penyaluran-bantuan-kemanusiaan",
                "category": "Kegiatan",
                "event_date": "2025-12-31",
                "location": "Aceh, Indonesia",
                "organizer": "DPP GRADASI",
                "image_path": "/uploads/event/1767154719.jpg",
                "excerpt": "Dewan Pimpinan Pusat (DPP) GRADASI menyalurkan bantuan...",
                "views": 80,
                "is_published": true,
                "gallery_count": 3,
                "created_at": "2025-12-31T08:00:00Z",
                "updated_at": "2025-12-31T08:00:00Z"
              }
            ],
            "meta": {
              "current_page": 1,
              "limit": 6,
              "total_data": 12,
              "total_pages": 2
            }
          }
        }
      }
    }
  },

  // ======================================================
  // LIST KATEGORI KEGIATAN (Public — distinct categories)
  // ======================================================
  "list_categories": {
    "method": "GET",
    "endpoint": "/api/v1/kegiatan/categories",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "None"
    },
    "headers": {
      "Accept": "application/json"
    },
    "parameters": {
      "query": {}
    },
    "notes": [
      "Mengembalikan daftar kategori unik (non-kosong) dari data kegiatan aktif (deleted_at IS NULL).",
      "Dipakai FE untuk dropdown filter kategori & opsi '+ Buat Kategori Baru' di admin."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil daftar kategori",
        "body": {
          "success": true,
          "code": "KEGIATAN_CATEGORIES",
          "message": "Daftar kategori kegiatan berhasil diambil.",
          "data": ["Jawa Timur", "Kegiatan Wilayah", "Lampung", "Nasional", "Seminar", "Workshop"]
        }
      }
    }
  },

  // ======================================================
  // DETAIL KEGIATAN (Public — by slug)
  // ======================================================
  "detail_public": {
    "method": "GET",
    "endpoint": "/api/v1/kegiatan/:slug",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "None"
    },
    "headers": {
      "Accept": "application/json"
    },
    "parameters": {
      "path": {
        "slug": "penyaluran-bantuan-kemanusiaan"
      }
    },
    "notes": [
      "Mengambil detail lengkap kegiatan termasuk gallery dan tags.",
      "Views counter otomatis bertambah setiap kali diakses."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil detail kegiatan",
        "body": {
          "success": true,
          "code": "KEGIATAN_DETAIL",
          "message": "Detail kegiatan berhasil diambil.",
          "data": {
            "id": 1,
            "title": "Penyaluran Bantuan Kemanusiaan oleh DPP GRADASI",
            "slug": "penyaluran-bantuan-kemanusiaan",
            "category": "Kegiatan",
            "event_date": "2025-12-31",
            "location": "Aceh, Indonesia",
            "organizer": "DPP GRADASI",
            "image_path": "/uploads/event/1767154719.jpg",
            "content": "<p>Isi detail kegiatan...</p>",
            "views": 81,
            "is_published": true,
            "tags": ["Kemanusiaan", "Donasi", "Aceh"],
            "gallery": [
              {
                "id": 1,
                "image_path": "/uploads/event/gallery1.jpg",
                "caption": "Serah terima",
                "sort_order": 0
              }
            ],
            "created_at": "2025-12-31T08:00:00Z"
          }
        }
      },
      "404": {
        "description": "Kegiatan tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Kegiatan tidak ditemukan."
        }
      }
    }
  },

  // ======================================================
  // LIST KEGIATAN (Admin — semua status)
  // ======================================================
  "list_admin": {
    "method": "GET",
    "endpoint": "/api/v1/kegiatan/admin",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "rate_limit": {
        "enabled": true,
        "key": "User",
        "limit": "30 request / menit"
      },
      "roles": ["super_admin", "admin", "editor"]
    },
    "parameters": {
      "query": {
        "page": "1",
        "limit": "10",
        "search": "bantuan",
        "category": "Kegiatan",
        "status": "published",     // published | draft | trashed | all
        "sort": "newest"           // newest | oldest | most_viewed
      }
    },
    "notes": [
      "Menampilkan semua kegiatan termasuk draft dan yang sudah dihapus (trashed).",
      "Hanya bisa diakses oleh user dengan role super_admin, admin, atau editor."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil daftar kegiatan (admin)",
        "body": {
          "success": true,
          "code": "KEGIATAN_LIST",
          "message": "Daftar kegiatan berhasil diambil.",
          "data": {
            "kegiatan": [
              {
                "id": 1,
                "title": "Penyaluran Bantuan Kemanusiaan oleh DPP GRADASI",
                "slug": "penyaluran-bantuan-kemanusiaan",
                "category": "Kegiatan",
                "event_date": "2025-12-31",
                "location": "Aceh, Indonesia",
                "organizer": "DPP GRADASI",
                "image_path": "/uploads/event/1767154719.jpg",
                "excerpt": "DPP GRADASI menyalurkan bantuan...",
                "is_published": true,
                "views": 80,
                "gallery_count": 3,
                "created_at": "2025-12-31T08:00:00Z",
                "updated_at": "2025-12-31T08:00:00Z"
              }
            ],
            "meta": {
              "current_page": 1,
              "limit": 10,
              "total_data": 12,
              "total_pages": 2
            }
          }
        }
      }
    }
  },

  // ======================================================
  // DETAIL KEGIATAN (Admin — by ID)
  // ======================================================
  "detail_admin": {
    "method": "GET",
    "endpoint": "/api/v1/kegiatan/id/:id",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin", "editor"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "responses": {
      "200": {
        "description": "Detail kegiatan berdasarkan ID (sama struktur dengan detail_public)",
        "body": {
          "success": true,
          "code": "KEGIATAN_DETAIL",
          "message": "Detail kegiatan berhasil diambil.",
          "data": {
            "id": 1,
            "title": "Penyaluran Bantuan Kemanusiaan oleh DPP GRADASI",
            "slug": "penyaluran-bantuan-kemanusiaan",
            "category": "Kegiatan",
            "event_date": "2025-12-31",
            "location": "Aceh, Indonesia",
            "organizer": "DPP GRADASI",
            "image_path": "/uploads/event/1767154719.jpg",
            "content": "<p>Isi detail kegiatan...</p>",
            "views": 81,
            "is_published": true,
            "tags": ["Kemanusiaan", "Donasi", "Aceh"],
            "gallery": [
              {
                "id": 1,
                "image_path": "/uploads/event/gallery1.jpg",
                "caption": "Serah terima",
                "sort_order": 0
              }
            ],
            "created_at": "2025-12-31T08:00:00Z"
          }
        }
      },
      "404": {
        "description": "Kegiatan tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Kegiatan tidak ditemukan."
        }
      }
    }
  },

  // ======================================================
  // CREATE KEGIATAN (Admin/Editor)
  // ======================================================
  "create": {
    "method": "POST",
    "endpoint": "/api/v1/kegiatan",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "rate_limit": {
        "enabled": true,
        "key": "User",
        "limit": "30 request / menit"
      },
      "roles": ["super_admin", "admin", "editor"]
    },
    "request": {
      "title": "Penyaluran Bantuan Kemanusiaan",
      "category": "Kegiatan",
      "event_date": "2025-12-31",
      "location": "Aceh, Indonesia",
      "organizer": "DPP GRADASI",
      "author_id": 1,
      "image_path": "https://images.unsplash.com/photo-xxx",
      "excerpt": "DPP GRADASI menyalurkan...",
      "content": "<p>HTML content...</p>",
      "is_published": true,
      "tags": "Kemanusiaan,Donasi,Aceh",
      "gallery": "[{\"image_path\":\"https://images.unsplash.com/photo-g1\",\"caption\":\"Serah terima\",\"sort_order\":0},{\"image_path\":\"https://images.unsplash.com/photo-g2\",\"caption\":\"Foto bersama\",\"sort_order\":1}]"
    },
    "validation": {
      "title": [
        { "tag": "required", "message": "Title wajib diisi, minimal 5 karakter." },
        { "tag": "min", "message": "Title minimal 5 karakter." },
        { "tag": "max", "message": "Title maksimal 300 karakter." }
      ],
      "content": [
        { "tag": "required", "message": "Content wajib diisi." }
      ]
    },
    "notes": [
      "Slug dibuat otomatis dari title oleh backend (gosimple/slug).",
      "author_id bersifat opsional. Jika tidak diisi, diambil otomatis dari token login.",
      "Gallery dikirim sebagai JSON string di field `gallery`.",
      "Hanya title (required,min=5,max=300) dan content (required) yang divalidasi backend (binding tag) — category, event_date, location, organizer, image_path, excerpt bersifat opsional walau field-nya ada."
    ],
    "responses": {
      "201": {
        "description": "Kegiatan berhasil dibuat",
        "body": {
          "success": true,
          "code": "KEGIATAN_CREATED",
          "message": "Kegiatan berhasil ditambahkan.",
          "data": {
            "id": 1,
            "title": "Penyaluran Bantuan Kemanusiaan",
            "slug": "penyaluran-bantuan-kemanusiaan",
            "category": "Kegiatan",
            "event_date": "2025-12-31",
            "location": "Aceh, Indonesia",
            "organizer": "DPP GRADASI",
            "image_path": "https://images.unsplash.com/photo-xxx",
            "content": "<p>HTML content...</p>",
            "is_published": true,
            "tags": ["Kemanusiaan", "Donasi", "Aceh"],
            "gallery": [
              {
                "id": 1,
                "image_path": "https://images.unsplash.com/photo-g1",
                "caption": "Serah terima",
                "sort_order": 0
              }
            ],
            "created_at": "2025-12-31T08:00:00Z"
          }
        }
      },
      "422": {
        "description": "Validasi input gagal (body tidak bisa di-bind / field wajib kosong)",
        "body": {
          "success": false,
          "code": "VALIDATION_ERROR",
          "message": "Validasi gagal.",
          "errors": [
            {
              "field": "title",
              "tag": "required",
              "message": "Title dan content wajib diisi."
            }
          ]
        }
      },
      "401": {
        "description": "Token tidak valid",
        "body": {
          "success": false,
          "code": "AUTH_TOKEN_INVALID_OR_EXPIRED",
          "message": "Sesi login telah berakhir. Silakan login kembali."
        }
      }
    }
  },

  // ======================================================
  // UPDATE KEGIATAN (Admin/Editor)
  // ======================================================
  "update": {
    "method": "PUT",
    "endpoint": "/api/v1/kegiatan/:id",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "rate_limit": {
        "enabled": true,
        "key": "User",
        "limit": "30 request / menit"
      },
      "roles": ["super_admin", "admin", "editor"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "request": {
      "title": "Penyaluran Bantuan Kemanusiaan (Updated)",
      "category": "Kegiatan",
      "event_date": "2025-12-31",
      "location": "Aceh, Indonesia",
      "organizer": "DPP GRADASI",
      "author_id": 1,
      "image_path": "https://images.unsplash.com/photo-yyy",
      "excerpt": "Excerpt baru...",
      "content": "<p>Konten baru...</p>",
      "is_published": true,
      "tags": "Kemanusiaan,Donasi,Aceh,Banjir",
      "gallery": "[{\"image_path\":\"https://images.unsplash.com/photo-g1-updated\",\"caption\":\"Serah terima update\",\"sort_order\":0}]"
    },
    "validation": {
      "title": [
        { "tag": "omitempty", "message": "Title bersifat opsional saat update." },
        { "tag": "min", "message": "Jika diisi, title minimal 5 karakter." },
        { "tag": "max", "message": "Title maksimal 300 karakter." }
      ]
    },
    "notes": [
      "Semua field bersifat partial update — kirim hanya field yang ingin diubah.",
      "Title (jika dikirim) divalidasi min=5,max=300, tapi tidak wajib diisi.",
      "Berbeda dengan endpoint create, field content TIDAK divalidasi (tidak ada binding required) di endpoint update."
    ],
    "responses": {
      "200": {
        "description": "Kegiatan berhasil diperbarui",
        "body": {
          "success": true,
          "code": "KEGIATAN_UPDATED",
          "message": "Kegiatan berhasil diperbarui.",
          "data": {
            "id": 1,
            "title": "Penyaluran Bantuan Kemanusiaan (Updated)",
            "slug": "penyaluran-bantuan-kemanusiaan-updated",
            "category": "Kegiatan",
            "event_date": "2025-12-31",
            "location": "Aceh, Indonesia",
            "organizer": "DPP GRADASI",
            "image_path": "https://images.unsplash.com/photo-yyy",
            "content": "<p>Konten baru...</p>",
            "is_published": true,
            "tags": ["Kemanusiaan", "Donasi", "Aceh", "Banjir"],
            "gallery": [
              {
                "id": 1,
                "image_path": "https://images.unsplash.com/photo-g1-updated",
                "caption": "Serah terima update",
                "sort_order": 0
              }
            ],
            "created_at": "2025-12-31T08:00:00Z"
          }
        }
      },
      "404": {
        "description": "Kegiatan tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Kegiatan tidak ditemukan."
        }
      }
    }
  },

  // ======================================================
  // DELETE KEGIATAN (Soft Delete — Admin/Editor)
  // ======================================================
  "delete": {
    "method": "DELETE",
    "endpoint": "/api/v1/kegiatan/:id",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin", "editor"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "notes": [
      "Soft delete — kolom deleted_at diisi, data masih di DB.",
      "Bisa dipulihkan via endpoint restore."
    ],
    "responses": {
      "200": {
        "description": "Kegiatan berhasil dihapus",
        "body": {
          "success": true,
          "code": "KEGIATAN_DELETED",
          "message": "Kegiatan berhasil dihapus."
        }
      },
      "404": {
        "description": "Kegiatan tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Kegiatan tidak ditemukan."
        }
      }
    }
  },

  // ======================================================
  // RESTORE KEGIATAN (Admin/Editor)
  // ======================================================
  "restore": {
    "method": "POST",
    "endpoint": "/api/v1/kegiatan/:id/restore",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin", "editor"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "responses": {
      "200": {
        "description": "Kegiatan berhasil dipulihkan",
        "body": {
          "success": true,
          "code": "KEGIATAN_RESTORED",
          "message": "Kegiatan berhasil dipulihkan."
        }
      }
    }
  },

  // ======================================================
  // DELETE GALLERY IMAGE (Admin/Editor)
  // ======================================================
  "delete_gallery_image": {
    "method": "DELETE",
    "endpoint": "/api/v1/kegiatan/gallery/:gallery_id",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin", "editor"]
    },
    "parameters": {
      "path": {
        "gallery_id": "1"
      }
    },
    "notes": [
      "Menghapus satu foto galeri dari kegiatan."
    ],
    "responses": {
      "200": {
        "description": "Foto galeri berhasil dihapus",
        "body": {
          "success": true,
          "code": "GALLERY_IMAGE_DELETED",
          "message": "Foto galeri berhasil dihapus."
        }
      },
      "404": {
        "description": "Foto galeri tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Foto galeri tidak ditemukan."
        }
      }
    }
  },

  // ======================================================
  // UPLOAD IMAGE KEGIATAN (Admin/Editor) — cover & galeri
  // ======================================================
  "upload_image": {
    "method": "POST",
    "endpoint": "/api/v1/kegiatan/upload-image",
    "consumes": "multipart/form-data",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin", "editor"],
      "rate_limit": "kegiatan-crud: 30 req/menit per user"
    },
    "request": {
      "form_data": {
        "image": "(file) PNG/JPG/WEBP, maks 5MB"
      }
    },
    "notes": [
      "Upload gambar cover/galeri kegiatan. Mengembalikan image_path yang bisa langsung dipakai di field image_path / gallery[].image_path saat create/update.",
      "Rate limit mengikuti kegiatan-crud (30 req/menit per user) karena route berada di grup admin."
    ],
    "responses": {
      "200": {
        "description": "Gambar berhasil diunggah",
        "body": {
          "success": true,
          "code": "IMAGE_UPLOADED",
          "message": "Gambar berhasil diunggah.",
          "data": {
            "image_path": "/uploads/kegiatan/1767154211.png"
          }
        }
      },
      "400": {
        "description": "File tidak valid (bukan gambar / terlalu besar)",
        "body": {
          "success": false,
          "code": "VALIDATION_ERROR",
          "message": "File harus berupa gambar PNG, JPG, atau WEBP maksimal 5MB"
        }
      },
      "401": {
        "description": "Token tidak valid / sesi berakhir",
        "body": {
          "success": false,
          "code": "AUTH_TOKEN_INVALID_OR_EXPIRED",
          "message": "Sesi login telah berakhir. Silakan login kembali."
        }
      }
    }
  },

    // ======================================================
    // BULK DELETE KEGIATAN
    // ======================================================
    "bulk_delete": {
      "method": "POST",
      "endpoint": "/api/v1/kegiatan/bulk-delete",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "ids": [1, 2, 3]
      },
      "responses": {
        "200": {
          "description": "Bulk delete berhasil",
          "body": {
            "success": true,
            "code": "KEGIATAN_BULK_DELETED",
            "message": "Kegiatan berhasil dihapus massal."
          }
        }
      }
    },

    // ======================================================
    // BULK RESTORE KEGIATAN
    // ======================================================
    "bulk_restore": {
      "method": "POST",
      "endpoint": "/api/v1/kegiatan/bulk-restore",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "ids": [1, 2, 3]
      },
      "responses": {
        "200": {
          "description": "Bulk restore berhasil",
          "body": {
            "success": true,
            "code": "KEGIATAN_BULK_RESTORED",
            "message": "Kegiatan berhasil dipulihkan massal."
          }
        }
      }
    }
}
