# Konfigurasi Database Lokal
DB_USER=root
DB_PASS=Mama14081980
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dpp_gradasi

# Konfigurasi Aplikasi
APP_NAME="DPP Gradasi"
APP_ENV=development
APP_URL=http://localhost:8080
PORT=8080

# Konfigurasi JWT
JWT_SECRET=ubah-ini-dengan-secret-panjang-minimal-32-karakter
JWT_ACCESS_TTL_MINS=15
JWT_REFRESH_TTL_HOURS=72
JWT_REMEMBER_ME_TTL_HOURS=720

# Konfigurasi Cookie
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAMESITE=Strict
COOKIE_PATH=/api/v1/auth

# Konfigurasi Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Konfigurasi Cloudflare Turnstile (CAPTCHA)
# Dapatkan Site Key & Secret Key dari Cloudflare Dashboard -> Turnstile.
# CAPTCHA_ENABLED: aktifkan verifikasi captcha (true/false)
#   - development: set false agar tidak wajib captcha saat develop
#   - production : set true + isi CAPTCHA_SITE_KEY & CAPTCHA_SECRET_KEY
# CAPTCHA_VERIFY_URL: endpoint verifikasi (default prod: challenges.cloudflare.com).
#   - Untuk mode development, set ke http://localhost:3000 (mock server) atau kosongkan
#     supaya helper melewati verifikasi (bypass) ketika secret kosong.
CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
CAPTCHA_VERIFY_URL=

# Konfigurasi SMTP (hanya untuk forgot password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=email@example.com
SMTP_PASS=password-aplikasi
SMTP_FROM_NAME="DPP Gradasi"
SMTP_ENCRYPTION=tls
SMTP_TIMEOUT_SECS=10

# Mode Development
DEV_SEED_ON_STARTUP=true
