{
  // =========================================================================
  // KONTRAK API - MODUL KONTAK
  // Endpoint prefix: /api/v1/kontak & /api/v1/admin/kontak
  // =========================================================================

  // ======================================================
  // SUBMIT PESAN KONTAK (Public Form)
  // ======================================================
  "submit": {
    "method": "POST",
    "endpoint": "/api/v1/kontak",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "None"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json"
    },
    "request": {
      "nama": "Ahmad Zaky",
      "email": "zaky@example.com",
      "subjek": "Kerjasama Literasi Digital",
      "pesan": "Halo DPP GRADASI, kami ingin mengajukan..."
    },
    "validation": {
      "nama": "required,min=3,max=100",
      "email": "required,email,max=150",
      "subjek": "required,max=200",
      "pesan": "required,min=10"
    },
    "notes": [
      "Endpoint publik untuk pengunjung website mengirim pesan kontak.",
      "Tidak memerlukan autentikasi."
    ],
    "responses": {
      "200": {
        "description": "Pesan berhasil dikirim",
        "body": {
          "success": true,
          "code": "KONTAK_SUBMITTED",
          "message": "Pesan Anda berhasil dikirim. Terima kasih!"
        }
      },
      "422": {
        "description": "Validasi input gagal",
        "body": {
          "success": false,
          "code": "VALIDATION_ERROR",
          "message": "Validasi gagal.",
          "errors": [
            {
              "field": "nama",
              "tag": "required",
              "message": "Nama, email, subjek, dan pesan wajib diisi."
            }
          ]
        }
      }
    }
  },

  // ======================================================
  // LIST PESAN MASUK (Admin Only)
  // ======================================================
  "list_admin": {
    "method": "GET",
    "endpoint": "/api/v1/admin/kontak",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "parameters": {
      "query": {
        "page": "1",
        "limit": "10",
        "search": "kerjasama",
        "status": "unread",
        "sort": "newest"
      }
    },
    "notes": [
      "status: unread | read | all | trashed.",
      "FIXED: nilai 'trashed' ditambahkan agar konsisten dengan modul berita/kegiatan/pengurus/sliders — sebelumnya endpoint restore/bulk_restore kontak ada, tapi tidak ada cara memfilter/menampilkan pesan yang sudah di-soft-delete untuk dipulihkan.",
      "sort: newest | oldest.",
      "Response list item TIDAK menyertakan response_note (hanya tersedia di detail_admin)."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil daftar pesan masuk",
        "body": {
          "success": true,
          "code": "KONTAK_LIST",
          "message": "Daftar pesan masuk berhasil diambil",
          "data": [
            {
              "id": 1,
              "nama": "Ahmad Zaky",
              "email": "zaky@example.com",
              "subjek": "Kerjasama",
              "pesan": "Halo...",
              "is_read": false,
              "created_at": "2026-07-30T11:44:31+07:00"
            }
          ],
          "meta": {
            "current_page": 1,
            "limit": 10,
            "total_data": 5,
            "total_pages": 1
          }
        }
      }
    }
  },

  // ======================================================
  // DETAIL & TANDAI PESAN DIBACA (Admin Only)
  // ======================================================
  "detail_admin": {
    "method": "GET",
    "endpoint": "/api/v1/admin/kontak/:id",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "notes": [
      "response_note = catatan internal admin terkait pesan ini (nullable, kosong jika belum pernah diisi).",
      "KEPUTUSAN: response_note tetap read-only untuk versi ini — endpoint untuk mengubahnya SENGAJA belum dibuat (bukan bug/gap yang belum diperbaiki). UI cukup menampilkan sebagai teks, tanpa form edit."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil detail pesan",
        "body": {
          "success": true,
          "code": "KONTAK_DETAIL",
          "message": "Detail pesan berhasil diambil",
          "data": {
            "id": 1,
            "nama": "Ahmad Zaky",
            "email": "zaky@example.com",
            "subjek": "Kerjasama",
            "pesan": "Halo DPP GRADASI, kami ingin mengajukan...",
            "is_read": true,
            "response_note": null,
            "created_at": "2026-07-30T11:44:31+07:00",
            "updated_at": "2026-07-30T11:44:31+07:00"
          }
        }
      },
      "404": {
        "description": "Pesan tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Pesan tidak ditemukan"
        }
      }
    }
  },

  // ======================================================
  // DELETE PESAN KONTAK (Admin Only)
  // ======================================================
  "delete": {
    "method": "DELETE",
    "endpoint": "/api/v1/admin/kontak/:id",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "responses": {
      "200": {
        "description": "Pesan berhasil dihapus",
        "body": {
          "success": true,
          "code": "KONTAK_DELETED",
          "message": "Pesan berhasil dihapus"
        }
      },
      "404": {
        "description": "Pesan tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Pesan tidak ditemukan"
        }
      }
    }
  },

  // ======================================================
  // RESTORE KONTAK
  // ======================================================
  "restore": {
    "method": "POST",
    "endpoint": "/api/v1/admin/kontak/:id/restore",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "responses": {
      "200": {
        "description": "Kontak berhasil dipulihkan",
        "body": {
          "success": true,
          "code": "KONTAK_RESTORED",
          "message": "Kontak berhasil dipulihkan."
        }
      }
    }
  },

  // ======================================================
  // BULK DELETE KONTAK
  // ======================================================
  "bulk_delete": {
    "method": "POST",
    "endpoint": "/api/v1/admin/kontak/bulk-delete",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "request": {
      "ids": [1, 2, 3]
    },
    "responses": {
      "200": {
        "description": "Bulk delete berhasil",
        "body": {
          "success": true,
          "code": "KONTAK_BULK_DELETED",
          "message": "Pesan berhasil dihapus massal."
        }
      }
    }
  },

  // ======================================================
  // BULK RESTORE KONTAK
  // ======================================================
  "bulk_restore": {
    "method": "POST",
    "endpoint": "/api/v1/admin/kontak/bulk-restore",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "request": {
      "ids": [1, 2, 3]
    },
    "responses": {
      "200": {
        "description": "Bulk restore berhasil",
        "body": {
          "success": true,
          "code": "KONTAK_BULK_RESTORED",
          "message": "Pesan berhasil dipulihkan massal."
        }
      }
    }
  }
}