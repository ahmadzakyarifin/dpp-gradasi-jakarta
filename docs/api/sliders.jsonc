{
  // =========================================================================
  // KONTRAK API - MODUL SLIDERS (CRUD tabel `sliders`)
  // Endpoint prefix: /api/v1/sliders
  // Relasi: created_by (User ID dari token login)
  // =========================================================================

  // ======================================================
  // LIST SLIDERS (Public — filter active)
  // ======================================================
  "list": {
    "method": "GET",
    "endpoint": "/api/v1/sliders",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "None"
    },
    "headers": {
      "Accept": "application/json"
    },
    "notes": [
      "Mengambil semua slider.",
      "Hanya mengembalikan slider yang berstatus aktif (is_active = true).",
      "Diurutkan berdasarkan sort_order ASC, created_at DESC."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil data slider",
        "body": {
          "success": true,
          "code": "SLIDERS_FETCHED",
          "message": "Data slider berhasil diambil.",
          "data": {
            "sliders": [
              {
                "id": 1,
                "title": "Musyawarah Nasional Ke-II GRADASI",
                "subtitle": "Kolaborasi Membangun Negeri...",
                "tag": "HEADLINE EVENT",
                "is_new": true,
                "event_date": "10 - 12 Agustus 2026",
                "location": "Jakarta Convention Center",
                "image_path": "/uploads/sliders/1749385864.jpg",
                "link_url": "/kegiatan/munas-ke-ii",
                "sort_order": 0,
                "is_active": true
              }
            ],
            "total": 1
          }
        }
      }
    }
  },

  // ======================================================
  // LIST SLIDERS (Admin — bisa lihat draft)
  // ======================================================
  "list_admin": {
    "method": "GET",
    "endpoint": "/api/v1/sliders/admin",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "parameters": {
      "query": {
        "active": "true (default) | false"
      }
    },
    "notes": [
      "Mengambil semua slider (field lengkap, sama seperti get_by_id) — response di bawah diringkas untuk keterbacaan, tapi setiap item slider berisi semua field yang sama dengan endpoint get_by_id, ditambah created_by/created_at/updated_at.",
      "?active=false untuk melihat semua slider termasuk non-aktif (draf).",
      "Diurutkan berdasarkan sort_order ASC, created_at DESC.",
      "created_by = ID user (admin) yang membuat slider tersebut, null jika dibuat sebelum kolom ini ada."
    ],
    "responses": {
      "200": {
        "description": "Berhasil mengambil data slider",
        "body": {
          "success": true,
          "code": "SLIDERS_FETCHED",
          "message": "Data slider berhasil diambil.",
          "data": {
            "sliders": [
              {
                "id": 1,
                "title": "Musyawarah Nasional Ke-II GRADASI",
                "subtitle": "Kolaborasi Membangun Negeri...",
                "tag": "HEADLINE EVENT",
                "is_new": true,
                "event_date": "10 - 12 Agustus 2026",
                "location": "Jakarta Convention Center",
                "image_path": "/uploads/sliders/1749385864.jpg",
                "link_url": "/kegiatan/munas-ke-ii",
                "sort_order": 0,
                "is_active": true,
                "created_by": 1,
                "created_at": "2026-07-20T09:00:00Z",
                "updated_at": "2026-07-20T09:00:00Z"
              }
            ],
            "total": 1
          }
        }
      }
    }
  },

  // ======================================================
  // REORDER SLIDERS (Admin/Editor)
  // ======================================================
  "reorder": {
    "method": "PUT",
    "endpoint": "/api/v1/sliders/reorder",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "request": {
      "ids": [3, 1, 2]
    },
    "validation": {
      "ids": [
        { "tag": "required", "message": "Daftar ID wajib dikirim." }
      ]
    },
    "notes": [
      "Mengubah urutan (sort_order) slider sesuai dengan urutan array ID yang dikirim."
    ],
    "responses": {
      "200": {
        "description": "Slider berhasil diurutkan",
        "body": {
          "success": true,
          "code": "SLIDERS_REORDERED",
          "message": "Urutan slider berhasil diperbarui."
        }
      }
    }
  },

  // ======================================================
  // GET BY ID (Public)
  // ======================================================
  "get_by_id": {
    "method": "GET",
    "endpoint": "/api/v1/sliders/:id",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "None"
    },
    "headers": {
      "Accept": "application/json"
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "responses": {
      "200": {
        "description": "Slider ditemukan",
        "body": {
          "success": true,
          "code": "SLIDER_FETCHED",
          "message": "Data slider berhasil diambil.",
          "data": {
            "id": 1,
            "title": "Musyawarah Nasional Ke-II GRADASI",
            "subtitle": "Kolaborasi Membangun Negeri...",
            "tag": "HEADLINE EVENT",
            "is_new": true,
            "event_date": "10 - 12 Agustus 2026",
            "location": "Jakarta Convention Center",
            "image_path": "/uploads/sliders/1749385864.jpg",
            "link_url": "/kegiatan/munas-ke-ii",
            "sort_order": 0,
            "is_active": true,
            "created_by": 1,
            "created_at": "2026-07-20T09:00:00Z",
            "updated_at": "2026-07-20T09:00:00Z"
          }
        }
      },
      "404": {
        "description": "Slider tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Slider tidak ditemukan."
        }
      }
    }
  },

  // ======================================================
  // CREATE SLIDER (Admin/Editor)
  // ======================================================
  "create": {
    "method": "POST",
    "endpoint": "/api/v1/sliders",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "rate_limit": {
        "enabled": true,
        "key": "User",
        "limit": "30 request / menit"
      },
      "roles": ["super_admin", "admin"]
    },
    "request": {
      "title": "Selamat Datang di DPP Gradasi",
      "subtitle": "Generasi Digital Indonesia",
      "tag": "NEW",
      "is_new": true,
      "event_date": "2026",
      "location": "Jakarta",
      "image_path": "https://images.unsplash.com/photo-xxx",
      "link_url": "https://dppgradasi.org",
      "sort_order": 0,
      "is_active": true
    },
    "validation": {
      "title": [
        { "tag": "required", "message": "Title wajib diisi." }
      ],
      "image_path": [
        { "tag": "required", "message": "Image URL wajib diisi." }
      ]
    },
    "notes": [
      "created_by diambil otomatis dari token login.",
      "Body pakai JSON biasa, bukan multipart. Image cukup URL string."
    ],
    "responses": {
      "201": {
        "description": "Slider berhasil dibuat",
        "body": {
          "success": true,
          "code": "SLIDER_CREATED",
          "message": "Slider berhasil dibuat.",
          "data": {
            "id": 1,
            "title": "Selamat Datang di DPP Gradasi",
            "subtitle": "Generasi Digital Indonesia",
            "tag": "NEW",
            "is_new": true,
            "event_date": "2026",
            "location": "Jakarta",
            "image_path": "https://images.unsplash.com/photo-xxx",
            "link_url": "https://dppgradasi.org",
            "sort_order": 0,
            "is_active": true
          }
        }
      },
      "422": {
        "description": "Validasi gagal",
        "body": {
          "success": false,
          "code": "VALIDATION_ERROR",
          "message": "Validasi gagal.",
          "errors": [
            {
              "field": "title",
              "tag": "required",
              "message": "Title wajib diisi."
            }
          ]
        }
      },
      "401": {
        "description": "Token tidak valid",
        "body": {
          "success": false,
          "code": "AUTH_TOKEN_INVALID_OR_EXPIRED",
          "message": "Sesi login telah berakhir. Silakan login kembali."
        }
      },
      "403": {
        "description": "Role tidak diizinkan",
        "body": {
          "success": false,
          "code": "FORBIDDEN",
          "message": "Anda tidak memiliki izin untuk melakukan aksi ini."
        }
      }
    }
  },

  // ======================================================
  // UPDATE SLIDER (Admin/Editor)
  // ======================================================
  "update": {
    "method": "PUT",
    "endpoint": "/api/v1/sliders/:id",
    "consumes": "application/json",
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "rate_limit": {
        "enabled": true,
        "key": "User",
        "limit": "30 request / menit"
      },
      "roles": ["super_admin", "admin"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "request": {
      "title": "Selamat Datang di DPP GRADASI",
      "subtitle": "Versi terbaru",
      "tag": "NEW",
      "is_new": false,
      "event_date": "2026",
      "location": "Jakarta",
      "image_path": "https://images.unsplash.com/photo-xxx",
      "link_url": "https://dppgradasi.org",
      "sort_order": 0,
      "is_active": true
    },
    "validation": {
      "title": [
        { "tag": "required", "message": "Title wajib diisi." }
      ],
      "image_path": [
        { "tag": "required", "message": "Image URL wajib diisi." }
      ]
    },
    "responses": {
      "200": {
        "description": "Slider berhasil diperbarui",
        "body": {
          "success": true,
          "code": "SLIDER_UPDATED",
          "message": "Slider berhasil diupdate.",
          "data": {
            "id": 1,
            "title": "Selamat Datang di DPP GRADASI",
            "subtitle": "Versi terbaru",
            "is_new": false,
            "image_path": "https://images.unsplash.com/photo-xxx",
            "sort_order": 0,
            "is_active": true
          }
        }
      },
      "404": {
        "description": "Slider tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Slider tidak ditemukan."
        }
      }
    }
  },

  // ======================================================
  // DELETE SLIDER (Admin/Editor)
  // ======================================================
  "delete": {
    "method": "DELETE",
    "endpoint": "/api/v1/sliders/:id",
    "consumes": null,
    "produces": "application/json",
    "authentication": {
      "type": "Bearer Access Token"
    },
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <access_token>"
    },
    "security": {
      "roles": ["super_admin", "admin"]
    },
    "parameters": {
      "path": {
        "id": "1"
      }
    },
    "notes": [
      "Soft delete — slider di-soft delete."
    ],
    "responses": {
      "200": {
        "description": "Slider berhasil dihapus",
        "body": {
          "success": true,
          "code": "SLIDER_DELETED",
          "message": "Slider berhasil dihapus."
        }
      },
      "404": {
        "description": "Slider tidak ditemukan",
        "body": {
          "success": false,
          "code": "NOT_FOUND",
          "message": "Slider tidak ditemukan."
        }
      }
    }
  },

    // ======================================================
    // RESTORE SLIDER
    // ======================================================
    "restore": {
      "method": "POST",
      "endpoint": "/api/v1/sliders/:id/restore",
      "consumes": null,
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "responses": {
        "200": {
          "description": "Slider berhasil dipulihkan",
          "body": {
            "success": true,
            "code": "SLIDER_RESTORED",
            "message": "Slider berhasil dipulihkan."
          }
        }
      }
    },

    // ======================================================
    // BULK DELETE SLIDER
    // ======================================================
    "bulk_delete": {
      "method": "POST",
      "endpoint": "/api/v1/sliders/bulk-delete",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "ids": [1, 2, 3]
      },
      "responses": {
        "200": {
          "description": "Bulk delete berhasil",
          "body": {
            "success": true,
            "code": "SLIDER_BULK_DELETED",
            "message": "Slider berhasil dihapus massal."
          }
        }
      }
    },

    // ======================================================
    // BULK RESTORE SLIDER
    // ======================================================
    "bulk_restore": {
      "method": "POST",
      "endpoint": "/api/v1/sliders/bulk-restore",
      "consumes": "application/json",
      "produces": "application/json",
      "authentication": {
        "type": "Bearer Access Token"
      },
      "headers": {
        "Accept": "application/json",
        "Authorization": "Bearer <access_token>"
      },
      "request": {
        "ids": [1, 2, 3]
      },
      "responses": {
        "200": {
          "description": "Bulk restore berhasil",
          "body": {
            "success": true,
            "code": "SLIDER_BULK_RESTORED",
            "message": "Slider berhasil dipulihkan massal."
          }
        }
      }
    }
}